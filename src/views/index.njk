{% extends "base.njk" %}

{% block content %}

{# ═══════════════════════════════════════════════════════
   HERO — full-viewport, real background photo
═══════════════════════════════════════════════════════ #}
<section
  id="hero"
  class="relative min-h-screen flex flex-col overflow-hidden"
  aria-label="Hero"
>
  <!-- Real hero background image -->
  <div
    class="absolute inset-0 bg-cover bg-center bg-no-repeat"
    style="background-image: url('/images/hero-bg.png');"
    aria-hidden="true"
  ></div>

  <!-- Dark overlay for readability -->
  <div class="absolute inset-0 bg-gradient-to-b from-black/70 via-black/50 to-black/80" aria-hidden="true"></div>

  <!-- Edge vignette -->
  <div class="absolute inset-0 [background:radial-gradient(ellipse_at_center,transparent_50%,rgba(0,0,0,0.5)_100%)]" aria-hidden="true"></div>

  <!-- Hero copy (left-aligned, vertically centered) -->
  <div class="relative z-10 flex-1 flex items-center">
    <div class="mx-auto w-full max-w-container px-5 sm:px-8 py-24 pt-36">
      <div class="max-w-xl">

        <p class="section-eyebrow-light mb-4">Epoch Possibilities LLC</p>

        <h1 class="font-sans font-black text-white uppercase
                   leading-[1.02] tracking-[-0.015em]
                   text-[2.75rem] sm:text-[3.75rem] lg:text-[4.5rem] mb-6">
          Build Your Next<br />Great Adventure
        </h1>

        <p class="text-white/70 text-base sm:text-lg leading-relaxed max-w-md mb-10">
          Intuitive &amp; versatile TTRPG terrain — magnetic tiles that let you
          build any scene before your players' eyes.
        </p>

        <a href="/products" class="btn-cta">
          Get Started Today
          <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24" stroke-width="2.5" aria-hidden="true">
            <path stroke-linecap="round" stroke-linejoin="round" d="M13.5 4.5L21 12m0 0l-7.5 7.5M21 12H3"/>
          </svg>
        </a>
      </div>
    </div>
  </div>

  {# ── Category navigation buttons ─────────────────────── #}
  <div class="relative z-10 mx-auto w-full max-w-container px-5 sm:px-8 pb-0">
    <div class="flex justify-start sm:justify-center overflow-x-auto scrollbar-thin pb-0">
      <div class="flex bg-white shadow-[0_8px_32px_rgba(0,0,0,0.5)] overflow-hidden shrink-0"
           role="navigation" aria-label="Product categories">

        <a href="/kits" class="cat-btn" aria-label="Shop Kits">
          <svg class="cat-btn-icon" fill="none" stroke="currentColor" stroke-width="1.5" viewBox="0 0 32 32" aria-hidden="true">
            <rect x="2"  y="3"  width="4" height="4" rx="0.5" fill="currentColor"/>
            <rect x="8"  y="3"  width="4" height="4" rx="0.5" fill="currentColor"/>
            <rect x="20" y="3"  width="4" height="4" rx="0.5" fill="currentColor"/>
            <rect x="26" y="3"  width="4" height="4" rx="0.5" fill="currentColor"/>
            <rect x="2"  y="7"  width="6" height="14" fill="currentColor"/>
            <rect x="24" y="7"  width="6" height="14" fill="currentColor"/>
            <rect x="8"  y="10" width="16" height="11" fill="currentColor"/>
            <rect x="13" y="16" width="6" height="5" fill="white"/>
            <rect x="2"  y="21" width="28" height="4" fill="currentColor"/>
          </svg>
          <span class="cat-btn-label">Kits</span>
        </a>

        <a href="/tiles" class="cat-btn" aria-label="Shop Tiles">
          <svg class="cat-btn-icon" fill="currentColor" viewBox="0 0 32 32" aria-hidden="true">
            <rect x="2"  y="2"  width="13" height="13" rx="1.5"/>
            <rect x="17" y="2"  width="13" height="13" rx="1.5"/>
            <rect x="2"  y="17" width="13" height="13" rx="1.5"/>
            <rect x="17" y="17" width="13" height="13" rx="1.5"/>
          </svg>
          <span class="cat-btn-label">Tiles</span>
        </a>

        <a href="/terrain" class="cat-btn" aria-label="Shop Terrain">
          <svg class="cat-btn-icon" fill="currentColor" viewBox="0 0 32 32" aria-hidden="true">
            <polygon points="16,2 30,26 2,26"/>
            <rect x="13" y="26" width="6" height="4"/>
          </svg>
          <span class="cat-btn-label">Terrain</span>
        </a>

        <a href="/products" class="cat-btn active" aria-label="Shop all products" aria-selected="true">
          <svg class="cat-btn-icon" fill="none" stroke="currentColor" stroke-width="1.8" viewBox="0 0 32 32" aria-hidden="true">
            <path stroke-linecap="round" stroke-linejoin="round"
                  d="M4 7h24l-2.5 12H6.5L4 7z M4 7L2 2H0"/>
            <circle cx="11" cy="25" r="2" fill="currentColor"/>
            <circle cx="23" cy="25" r="2" fill="currentColor"/>
          </svg>
          <span class="cat-btn-label">Shop</span>
        </a>

      </div>
    </div>
  </div>

  <!-- Ink fade transition into next section -->
  <div class="relative z-10 pointer-events-none w-full" aria-hidden="true">
    <img
      src="/images/fade-transition-black.png"
      alt=""
      class="w-full block"
      style="height: 80px; object-fit: cover; object-position: bottom; margin-bottom: -1px;"
      loading="eager"
    />
  </div>
</section>


{# ═══════════════════════════════════════════════════════
   FEATURES — white background
   "Landscapes as Diverse as Your Imagination"
═══════════════════════════════════════════════════════ #}
<section id="features" class="bg-white pt-20 pb-16 sm:pt-28 sm:pb-24" aria-label="Key features">
  <div class="mx-auto max-w-container px-5 sm:px-8">
    <div class="grid grid-cols-1 lg:grid-cols-2 gap-12 lg:gap-20 items-start">

      <!-- LEFT: Headline + body + CTA + scenic image -->
      <div>
        <h2 class="heading-dark mb-7 leading-tight">
          Landscapes as Diverse<br />as Your Imagination
        </h2>

        <p class="body-dark mb-8 max-w-[520px]">
          Epochscapes is an intuitive and versatile TTRPG terrain that allows any dungeon master
          to quickly create their battle map and scene before their players' eyes.
          Bring your setting into reality.
        </p>

        <a href="/kits" class="btn-cta mb-12 sm:mb-16 inline-flex">Get Started Today!</a>

        <!-- Scenic terrain illustration — POV from miniature level -->
        <div class="relative overflow-hidden" style="height: 300px;">
          <img
            src="/images/terrain-pov.png"
            alt="Epochscapes terrain — a player's eye view through castle walls and scenery"
            class="w-full h-full object-cover object-center"
            loading="lazy"
          />
          <!-- Soft bottom fade to blend into white -->
          <div class="absolute inset-x-0 bottom-0 h-20 bg-gradient-to-t from-white to-transparent pointer-events-none"></div>
          <div class="absolute inset-x-0 top-0 h-10 bg-gradient-to-b from-white to-transparent pointer-events-none"></div>
        </div>
      </div>

      <!-- RIGHT: 3 feature blocks -->
      <div class="flex flex-col divide-y divide-zinc-100 lg:pt-2">

        <!-- Double-Sided Tiles -->
        <div class="feature-block py-9 first:pt-0 last:pb-0">
          <svg class="feature-icon-green shrink-0" fill="none" stroke="currentColor" stroke-width="1.8" viewBox="0 0 48 48" aria-hidden="true">
            <rect x="4"  y="4"  width="18" height="18" rx="2" stroke-width="2"/>
            <rect x="12" y="12" width="18" height="18" rx="2" fill="currentColor" fill-opacity="0.12" stroke-width="2"/>
            <rect x="26" y="4"  width="18" height="18" rx="2" stroke-width="2"/>
            <rect x="4"  y="26" width="18" height="18" rx="2" stroke-width="2"/>
            <rect x="26" y="26" width="18" height="18" rx="2" fill="currentColor" fill-opacity="0.25" stroke-width="2"/>
          </svg>
          <div>
            <h3 class="feature-title mb-2">Double-Sided Tiles</h3>
            <p class="feature-body">
              Create fantasy worlds with your choice of sand, water, cave, castle, grass, and more.
              Double-sided tiles get you more creative bang for your buck.
            </p>
          </div>
        </div>

        <!-- Magnetic Connection -->
        <div class="feature-block py-9">
          <svg class="feature-icon-green shrink-0" fill="none" stroke="currentColor" stroke-width="1.8" viewBox="0 0 48 48" aria-hidden="true">
            <path d="M10 8 h6 v20 a8 8 0 0 0 16 0 V8 h6" stroke-linecap="round" stroke-linejoin="round"/>
            <rect x="10" y="32" width="7" height="6" rx="0" fill="currentColor" stroke="none"/>
            <rect x="31" y="32" width="7" height="6" rx="0" fill="currentColor" stroke="none"/>
          </svg>
          <div>
            <h3 class="feature-title mb-2">Magnetic Connection</h3>
            <p class="feature-body">
              Our magnetic dungeon tiles' lightweight and easily interchangeable design makes setup
              a breeze. No tin trays. No finger-aching clips. Just terrain that seemingly builds itself.
            </p>
          </div>
        </div>

        <!-- Modular Terrain -->
        <div class="feature-block py-9 last:pb-0">
          <svg class="feature-icon-green shrink-0" fill="currentColor" viewBox="0 0 48 48" aria-hidden="true">
            <polygon points="24,4 44,40 4,40" fill-opacity="0.9"/>
            <polygon points="14,40 27,16 40,40" fill="white" fill-opacity="0.3"/>
          </svg>
          <div>
            <h3 class="feature-title mb-2">Modular Terrain</h3>
            <p class="feature-body">
              Embark on epic adventures anytime, anywhere. Our terrain is the dynamic solution
              for any tabletop or war game that works with the standard 25mm scale.
            </p>
          </div>
        </div>

      </div>
    </div>
  </div>
</section>


{# ═══════════════════════════════════════════════════════
   Ink / smoke transition — white → black
═══════════════════════════════════════════════════════ #}
<div class="bg-white -mb-px pointer-events-none overflow-hidden" aria-hidden="true" style="line-height:0;">
  <svg viewBox="0 0 1440 56" preserveAspectRatio="none" class="w-full" style="display:block; height:56px;">
    <path d="M0,56 C180,20 300,56 480,30 C600,14 720,50 900,22 C1080,0 1260,40 1440,14 L1440,56 Z" fill="#000000"/>
  </svg>
</div>


{# ═══════════════════════════════════════════════════════
   KITS — dark background, product card row
   "Explore Our Kits"
═══════════════════════════════════════════════════════ #}
<section id="kits" class="bg-[#000000] py-20 sm:py-28" aria-label="Explore kits">
  <div class="mx-auto max-w-container px-5 sm:px-8">

    <div class="flex flex-col sm:flex-row sm:items-end sm:justify-between gap-6 mb-12">
      <div>
        <span class="section-eyebrow-light">Themed Packages</span>
        <h2 class="heading-light">Explore Our Kits</h2>
      </div>
      <a href="/kits" class="btn-cta shrink-0">Shop All Kits</a>
    </div>

    <!-- Kit cards -->
    <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-4 gap-4">
      {% set kitImages = [
        '/images/terrain-651830478.jpeg',
        '/images/lifestyle-532216565.jpeg',
        '/images/terrain-651830444.jpeg',
        '/images/lifestyle-751658706.jpeg'
      ] %}
      {% set kitImagePos = ['center', 'center', 'center top', 'center'] %}
      {% for p in products %}
        {% if p.category === 'kits' %}
          <a href="{{ p.slug }}"
             class="product-card-dark group block no-underline
                    focus-visible:ring-2 focus-visible:ring-brand-green focus-visible:ring-offset-2
                    focus-visible:outline-none focus-visible:ring-offset-[#000000]"
             aria-label="{{ p.name }}{% if p.priceLabel %} — {{ p.priceLabel }}{% endif %}">

            <div class="relative overflow-hidden" style="height:208px;">
              <img
                src="{{ kitImages[loop.index0 % 4] }}"
                alt="{{ p.name }}"
                class="w-full h-full object-cover transition-transform duration-500 group-hover:scale-105"
                style="object-position: {{ kitImagePos[loop.index0 % 4] }};"
                loading="lazy"
              />
              <!-- Dark overlay for text readability -->
              <div class="absolute inset-0 bg-gradient-to-t from-black/60 via-black/20 to-transparent"></div>

              {% if p.badge %}
                <span class="absolute top-3 left-3 px-2 py-0.5 bg-brand-red text-white
                             text-[10px] font-sans font-bold tracking-widest uppercase z-10">
                  {{ p.badge }}
                </span>
              {% endif %}
            </div>

            <div class="p-4">
              <h3 class="text-[13px] font-sans font-bold text-white tracking-[0.06em] uppercase mb-1
                         group-hover:text-brand-green transition-colors leading-snug">
                {{ p.name }}
              </h3>
              {% if p.description %}
                <p class="text-zinc-500 text-[12px] leading-relaxed mb-3 line-clamp-2">{{ p.description }}</p>
              {% endif %}
              <div class="flex items-center justify-between pt-2 border-t border-zinc-800">
                <span class="text-brand-green font-sans font-bold text-[13px] tracking-wide">
                  {{ p.priceLabel }}
                </span>
                <span class="text-[10px] font-sans font-bold tracking-widest uppercase
                             text-zinc-500 group-hover:text-white transition-colors"
                      aria-hidden="true">
                  View →
                </span>
              </div>
            </div>
          </a>
        {% endif %}
      {% endfor %}
    </div>

  </div>
</section>


{# ═══════════════════════════════════════════════════════
   Smoke divider — black → white
═══════════════════════════════════════════════════════ #}
<div class="bg-[#000000] -mb-px pointer-events-none overflow-hidden" aria-hidden="true" style="line-height:0;">
  <svg viewBox="0 0 1440 56" preserveAspectRatio="none" class="w-full" style="display:block; height:56px;">
    <path d="M0,0 C180,52 360,8 600,36 C780,56 960,8 1140,34 C1280,52 1380,18 1440,0 L1440,56 L0,56 Z" fill="white"/>
  </svg>
</div>


{# ═══════════════════════════════════════════════════════
   BUILD & CHANGE — white background
   "Insanely Intuitive to Build & Change"
═══════════════════════════════════════════════════════ #}
<section class="bg-white py-20 sm:py-28" aria-label="How it works">
  <div class="mx-auto max-w-container px-5 sm:px-8">
    <div class="grid grid-cols-1 lg:grid-cols-2 gap-12 lg:gap-20 items-center">

      <!-- Text side -->
      <div>
        <h2 class="heading-dark mb-6 leading-tight">
          Insanely Intuitive<br />to Build &amp; Change
        </h2>
        <p class="body-dark mb-6">
          You prepared a castle before the game, but the players wanted to go to the forest?
          Happens all the time. Epochscapes makes it easy to completely shift the scene in minutes.
        </p>
        <p class="body-dark mb-8">
          Take your dungeon terrain to a new level. Let your players fight the monster when it's
          best for the story. Let them find the hidden gold with dynamic scenery.
          Make unbounded arenas that befit their miniatures.
        </p>

        <h3 class="subheading-dark mb-4">Modular &amp; Versatile</h3>
        <p class="body-dark mb-8">
          Keep your players highly engaged with Epoch Tile's detailed custom pieces while building
          a tabletop fantasy world from your imagination.
        </p>

        <a href="/products" class="btn-cta inline-flex">Shop All Products</a>
      </div>

      <!-- Lifestyle photo + product tile row -->
      <div class="space-y-4">

        <!-- Primary lifestyle photo: players at the table -->
        <div class="relative overflow-hidden" style="height: 320px;">
          <img
            src="/images/lifestyle-tabletop.png"
            alt="Two players enjoying Epochscapes terrain at the gaming table"
            class="w-full h-full object-cover object-top"
            loading="lazy"
          />
          <!-- Soft edges top + bottom -->
          <div class="absolute inset-x-0 top-0 h-12 bg-gradient-to-b from-white to-transparent pointer-events-none"></div>
          <div class="absolute inset-x-0 bottom-0 h-16 bg-gradient-to-t from-white to-transparent pointer-events-none"></div>
        </div>

        <!-- Three tile pack thumbnails -->
        <div class="grid grid-cols-3 gap-3">
          <div class="relative overflow-hidden" style="height:110px;">
            <img
              src="/images/terrain-651830478.jpeg"
              alt="Stone & Water terrain tiles"
              class="w-full h-full object-cover object-center"
              loading="lazy"
            />
            <div class="absolute inset-0 bg-gradient-to-t from-black/70 to-black/10 flex items-end p-2">
              <span class="text-[9px] text-white/90 font-sans font-bold tracking-widest uppercase leading-tight">Stone &amp; Water</span>
            </div>
          </div>
          <div class="relative overflow-hidden" style="height:110px;">
            <img
              src="/images/terrain-651830444.jpeg"
              alt="Castle & Grass terrain tiles"
              class="w-full h-full object-cover object-center"
              loading="lazy"
            />
            <div class="absolute inset-0 bg-gradient-to-t from-black/70 to-black/10 flex items-end p-2">
              <span class="text-[9px] text-white/90 font-sans font-bold tracking-widest uppercase leading-tight">Castle &amp; Grass</span>
            </div>
          </div>
          <div class="relative overflow-hidden" style="height:110px;">
            <img
              src="/images/lifestyle-751658706.jpeg"
              alt="Sand & Water terrain tiles"
              class="w-full h-full object-cover object-center"
              loading="lazy"
            />
            <div class="absolute inset-0 bg-gradient-to-t from-black/70 to-black/10 flex items-end p-2">
              <span class="text-[9px] text-white/90 font-sans font-bold tracking-widest uppercase leading-tight">Sand &amp; Water</span>
            </div>
          </div>
        </div>

      </div>
    </div>
  </div>
</section>


{# ═══════════════════════════════════════════════════════
   Smoke divider — white → black
═══════════════════════════════════════════════════════ #}
<div class="bg-white -mb-px pointer-events-none overflow-hidden" aria-hidden="true" style="line-height:0;">
  <svg viewBox="0 0 1440 56" preserveAspectRatio="none" class="w-full" style="display:block; height:56px;">
    <path d="M0,56 C240,16 420,56 660,30 C840,10 1020,50 1260,24 C1340,12 1400,36 1440,56 L1440,0 L0,0 Z" fill="#000000"/>
  </svg>
</div>


{# ═══════════════════════════════════════════════════════
   BATTLE MAPS — dark background, terrain POV photo
   "Create Battle Maps on the Fly"
═══════════════════════════════════════════════════════ #}
<section id="battle-maps" class="bg-[#000000] py-20 sm:py-28 overflow-hidden" aria-label="Create battle maps">
  <div class="mx-auto max-w-container px-5 sm:px-8">
    <div class="grid grid-cols-1 lg:grid-cols-2 gap-12 lg:gap-16 items-center">

      <!-- Text -->
      <div>
        <span class="section-eyebrow-light">DM-Ready Terrain</span>
        <h2 class="heading-light mb-6 leading-tight">
          Create Battle Maps<br />on the Fly
        </h2>
        <p class="body-light mb-6">
          Keep your players highly engaged with Epoch Tile's detailed custom pieces while building
          a tabletop fantasy world from your imagination.
        </p>
        <p class="body-light mb-6">
          Unchain your terrain with limitless combinations of tiles, walls, and detailed scenery.
          Epoch Tiles make it easy to give your dungeons dimension.
        </p>
        <p class="body-light mb-8">
          Take your players through ancient forest roads, deserts of sand, mountains of dirt and
          rock, oceans of water, castles of stone — the options are endless.
        </p>
        <a href="/products" class="btn-cta inline-flex">Shop Now</a>
      </div>

      <!-- Terrain in action — real POV photo -->
      <div class="relative">
        <div class="relative overflow-hidden" style="height: 420px;">
          <img
            src="/images/terrain-pov.png"
            alt="Close-up view through the terrain — the miniature's perspective of Epochscapes tiles and scenery"
            class="w-full h-full object-cover object-center"
            loading="lazy"
          />
          <!-- Dark edges to blend into black section bg -->
          <div class="absolute inset-0 [box-shadow:inset_0_0_60px_rgba(0,0,0,0.7)] pointer-events-none"></div>
          <div class="absolute inset-x-0 bottom-0 h-20 bg-gradient-to-t from-black to-transparent pointer-events-none"></div>
          <div class="absolute inset-x-0 top-0 h-12 bg-gradient-to-b from-black to-transparent pointer-events-none"></div>
        </div>
      </div>

    </div>
  </div>
</section>


{# ═══════════════════════════════════════════════════════
   Smoke divider — black → white
═══════════════════════════════════════════════════════ #}
<div class="bg-[#000000] -mb-px pointer-events-none overflow-hidden" aria-hidden="true" style="line-height:0;">
  <svg viewBox="0 0 1440 56" preserveAspectRatio="none" class="w-full" style="display:block; height:56px;">
    <path d="M0,0 C160,52 320,4 560,32 C720,52 900,8 1080,32 C1220,52 1360,14 1440,0 L1440,56 L0,56 Z" fill="white"/>
  </svg>
</div>


{# ═══════════════════════════════════════════════════════
   TILES GALLERY — white background, product grid
   "Landscapes as Diverse…"
═══════════════════════════════════════════════════════ #}
<section id="tiles" class="bg-white py-20 sm:py-28" aria-label="Tile packs gallery">
  <div class="mx-auto max-w-container px-5 sm:px-8">

    <div class="flex flex-col sm:flex-row sm:items-end sm:justify-between gap-6 mb-12">
      <div>
        <span class="section-eyebrow">The Full Collection</span>
        <h2 class="heading-dark">
          Landscapes as Diverse as<br class="hidden sm:block"/>Your Imagination
        </h2>
      </div>

      <div class="flex gap-2 shrink-0" role="tablist" aria-label="Filter by category">
        <button
          class="filter-btn filter-btn-active"
          hx-get="/partials/products"
          hx-target="#product-grid"
          hx-swap="innerHTML"
          hx-indicator="#product-loading"
          role="tab" aria-selected="true"
        >All</button>
        <button
          class="filter-btn"
          hx-get="/partials/products?category=kits"
          hx-target="#product-grid"
          hx-swap="innerHTML"
          hx-indicator="#product-loading"
          role="tab" aria-selected="false"
        >Kits</button>
        <button
          class="filter-btn"
          hx-get="/partials/products?category=tiles"
          hx-target="#product-grid"
          hx-swap="innerHTML"
          hx-indicator="#product-loading"
          role="tab" aria-selected="false"
        >Tiles</button>
        <button
          class="filter-btn"
          hx-get="/partials/products?category=accessories"
          hx-target="#product-grid"
          hx-swap="innerHTML"
          hx-indicator="#product-loading"
          role="tab" aria-selected="false"
        >Accessories</button>
      </div>
    </div>

    <div id="product-loading" class="htmx-indicator flex justify-center py-8" aria-live="polite">
      <div class="w-5 h-5 border-2 border-zinc-200 border-t-brand-green rounded-full animate-spin"></div>
    </div>

    <div id="product-grid">
      {% include "partials/product-grid.njk" %}
    </div>

  </div>
</section>


{# ═══════════════════════════════════════════════════════
   STAY UPDATED — newsletter + Elfsight social feed
═══════════════════════════════════════════════════════ #}
<section class="bg-zinc-50 border-t border-zinc-200 py-16 sm:py-20" aria-label="Newsletter and social feed">
  <div class="mx-auto max-w-container px-5 sm:px-8">

    <div class="max-w-xl mx-auto text-center mb-14">
      <h2 class="heading-dark text-2xl sm:text-3xl mb-3">Stay Updated</h2>
      <p class="body-dark text-sm mb-8">
        New kits, terrain ideas, and DM tips — straight to your inbox.
      </p>


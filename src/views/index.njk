{# ═══════════════════════════════════════════════════════
   JOIN THE ADVENTURE — dark with fantasy castle bg
═══════════════════════════════════════════════════════ #}
<section class="relative overflow-hidden py-24 sm:py-36" aria-label="Join the adventure">

  <!-- Fantasy castle / landscape background image -->
  <div class="absolute inset-0 bg-cover bg-center bg-no-repeat"
       style="background-image: url('/images/castle-fantasy.jpeg');"
       aria-hidden="true"></div>

  <!-- Rich dark overlay with purple-to-black gradient (matches fantasy mood) -->
  <div class="absolute inset-0 bg-gradient-to-b from-black/60 via-black/50 to-black/80" aria-hidden="true"></div>
  <div class="absolute inset-0 [background:radial-gradient(ellipse_at_50%_0%,rgba(80,40,140,0.4)_0%,transparent_70%)]" aria-hidden="true"></div>

  <!-- Content -->
  <div class="relative z-10 mx-auto max-w-lg px-5 sm:px-8 text-center">
    <h2 class="font-sans font-black text-white text-[2.5rem] sm:text-[3rem] lg:text-[3.5rem] uppercase
               leading-tight tracking-[-0.01em] mb-5">
      Join the<br />Adventure
    </h2>
    <p class="text-white/65 text-base sm:text-lg mb-10 leading-relaxed">
      Get exclusive discounts, new product announcements, and inspiration for your next session.
    </p>

    <form class="flex flex-col sm:flex-row gap-3 max-w-sm mx-auto"
          onsubmit="event.preventDefault(); alert('Email signup coming soon!')">
      <label for="adventure-email" class="sr-only">Email address</label>
      <input
        id="adventure-email"
        type="email"
        name="email"
        placeholder="Your email address"
        required
        class="flex-1 px-4 py-3.5 bg-white/10 border border-white/25 text-white text-sm font-sans
               placeholder-white/40
               focus:outline-none focus:border-white/60 focus:bg-white/15 transition-colors"
      />
      <button type="submit" class="btn-cta py-3.5 px-6 shrink-0">Join Now</button>
    </form>
  </div>
</section>

{% endblock %}

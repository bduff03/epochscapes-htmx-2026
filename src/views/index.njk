</section>

{# ═══════════════════════════════════════════════════════════
   STORY BLOCK 2 — Craft Immersive Scenes Fast
════════════════════════════════════════════════════════════ #}
<section class="bg-brand-surface border-t border-brand-border py-20 sm:py-28 overflow-hidden" aria-label="Craft immersive scenes">
  <div class="mx-auto max-w-7xl px-4 sm:px-6 lg:px-8">
    <div class="grid grid-cols-1 lg:grid-cols-2 gap-12 lg:gap-20 items-center">

      <!-- Text (left) -->
      <div>
        <span class="section-label">Limitless Combinations</span>
        <h2 class="section-heading mb-6">
          Craft Immersive Scenes<br />
          <span class="text-gradient">Fast</span>
        </h2>
        <div class="space-y-4 text-brand-muted text-base leading-relaxed">
          <p>
            Unchain your terrain with limitless combinations of tiles, walls, and detailed scenery.
            Epoch Tiles make it easy to give your dungeons dimension.
          </p>
          <p>
            Take your players through ancient forest roads, deserts of sand, mountains of dirt and
            rock, oceans of water, castles of stone — the options are endless.
          </p>
          <p>
            Our wide selection of custom pieces will bring your game to life. Give your player and
            creature miniatures the terrain they deserve.
          </p>
        </div>

        <!-- Feature list -->
        <ul class="mt-8 space-y-3" role="list">
          {% set perks = [
            'Works with standard 25mm scale miniatures',
            'No setup tools needed — magnetic snap connection',
            'Mix any tile packs and kit pieces freely',
            'Lightweight enough to travel to game nights'
          ] %}
          {% for perk in perks %}
            <li class="flex items-start gap-3 text-sm text-brand-muted">
              <svg class="w-4 h-4 text-brand-gold mt-0.5 shrink-0" fill="none" stroke="currentColor" viewBox="0 0 24 24" stroke-width="2.5" aria-hidden="true">
                <path stroke-linecap="round" stroke-linejoin="round" d="M4.5 12.75l6 6 9-13.5"/>
              </svg>
              {{ perk }}
            </li>
          {% endfor %}
        </ul>

        <div class="mt-8">
          <a href="/#categories" class="btn-primary text-sm">Explore the Collection</a>
        </div>
      </div>

      <!-- Visual: biome variety showcase -->
      <div class="relative" aria-hidden="true">
        <div class="absolute inset-0 bg-brand-gold/5 rounded-3xl blur-3xl scale-110"></div>
        <div class="relative grid grid-cols-2 gap-3">
          {% set biomes = [
            {name:'Ancient Woodlands',  color:'from-green-900 to-emerald-950',  label:'Kit'},
            {name:'Crystal Caverns',    color:'from-indigo-900 to-purple-950',   label:'Kit'},
            {name:'Castle & Stone',     color:'from-stone-800 to-zinc-900',      label:'Tiles'},
            {name:'Endless Sands',      color:'from-amber-900 to-yellow-950',    label:'Kit'},
            {name:'Sand & Water',       color:'from-cyan-900 to-blue-950',       label:'Tiles'},
            {name:'Hidden Temple',      color:'from-orange-900 to-red-950',      label:'Kit'}
          ] %}
          {% for b in biomes %}
            <div class="relative rounded-xl overflow-hidden border border-brand-border
                        bg-gradient-to-br {{ b.color }} h-28 sm:h-32
                        flex flex-col justify-between p-3
                        hover:border-brand-gold/30 transition-colors">
              <span class="text-xs font-sans font-semibold text-white/50 uppercase tracking-widest">{{ b.label }}</span>
              <span class="text-xs font-sans font-medium text-white/80 leading-tight">{{ b.name }}</span>
              <!-- Tile pattern overlay -->
              <div class="absolute inset-0 bg-tile-pattern bg-tile opacity-20"></div>
            </div>
          {% endfor %}
        </div>
      </div>

    </div>
  </div>
</section>

{# ═══════════════════════════════════════════════════════════
   FAQ stub — Alpine.js accordion (HTMX-ready for lazy load)
════════════════════════════════════════════════════════════ #}
<section class="bg-brand-bg border-t border-brand-border py-20 sm:py-24" aria-label="Frequently asked questions">
  <div class="mx-auto max-w-3xl px-4 sm:px-6 lg:px-8">
    <div class="text-center mb-12">
      <span class="section-label">FAQ</span>
      <h2 class="section-heading text-3xl">Common Questions</h2>
    </div>

    <div class="space-y-2"
         x-data="{ open: null }"
         role="list">
      {% set faqs = [
        {
          q: 'What scale are Epochscapes tiles?',
          a: 'Epochscapes tiles are designed for the standard 25mm (1-inch grid) scale used by D&D, Pathfinder, and most tabletop RPGs. Each tile square equals one inch.'
        },
        {
          q: 'How does the magnetic connection work?',
          a: 'Each tile has embedded magnets on its edges. Just place tiles adjacent to each other and they snap together. No tools, clips, or trays required — the magnetic field is strong enough to hold terrain in place but light enough to rearrange in seconds.'
        },
        {
          q: 'Are tiles double-sided?',
          a: 'Yes. Every Epochscapes tile is double-sided with two distinct biomes — for example Stone & Water, or Castle & Grass. This doubles the terrain combinations you can build from any single pack.'
        },
        {
          q: 'What comes in a Kit vs. a Tile Pack?',
          a: 'Kits are themed complete sets that include tiles, walls, detailed accessory pieces (pillars, crystals, trees, etc.) all matching a single theme. Tile Packs are just the core tiles in a biome pair — ideal for expanding your collection.'
        },
        {
          q: 'When will my order ship?',
          a: 'Orders typically ship within 2–3 business days from Lehi, UT. You\'ll receive a tracking email once dispatched.'
        }
      ] %}

      {% for faq in faqs %}
        <div class="rounded-lg border border-brand-border bg-brand-surface overflow-hidden"
             x-data="{ isOpen: false }"
             role="listitem">
          <button
            @click="isOpen = !isOpen"
            class="w-full flex items-center justify-between px-5 py-4 text-left
                   text-sm font-sans font-medium text-white hover:text-brand-gold-light
                   transition-colors"
            :aria-expanded="isOpen"
          >
            <span>{{ faq.q }}</span>
            <svg class="w-4 h-4 text-brand-muted shrink-0 transition-transform duration-200"
                 :class="isOpen ? 'rotate-180' : ''"
                 fill="none" stroke="currentColor" viewBox="0 0 24 24" stroke-width="2" aria-hidden="true">
              <path stroke-linecap="round" stroke-linejoin="round" d="M19.5 8.25l-7.5 7.5-7.5-7.5"/>
            </svg>
          </button>
          <div x-show="isOpen"
               x-transition:enter="transition ease-out duration-200"
               x-transition:enter-start="opacity-0 -translate-y-1"
               x-transition:enter-end="opacity-100 translate-y-0"
               x-transition:leave="transition ease-in duration-150"
               x-transition:leave-start="opacity-100"
               x-transition:leave-end="opacity-0"
               class="px-5 pb-4">
            <p class="text-sm text-brand-muted leading-relaxed">{{ faq.a }}</p>
          </div>
        </div>
      {% endfor %}
    </div>
  </div>
</section>

{% endblock %}

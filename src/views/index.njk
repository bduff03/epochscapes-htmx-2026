{% extends "base.njk" %}
{% from "partials/ink-divider.njk" import inkDivider %}
{% from "partials/brush-mask.njk" import brushMask %}

{% block content %}

{# ═══════════════════════════════════════════════════════
   HERO + CTA BAR — Figma 22:63 / 94:7
═══════════════════════════════════════════════════════ #}
<section id="hero" class="relative h-[560px] sm:h-[625px]" aria-label="Hero">
  <div class="absolute inset-0 overflow-hidden" aria-hidden="true">
    <img
      src="/images/home-v2/hero-bg.jpg"
      alt=""
      class="absolute inset-0 h-full w-full max-w-none object-cover object-[50%_0%]"
      width="1600" height="900"
      fetchpriority="high"
    />
    <img src="/images/home-v2/hero-overlay.svg" alt="" class="absolute inset-0 h-full w-full max-w-none" />
  </div>

  <div class="container-home relative z-10 pt-[170px] sm:pt-[269px]">
    <h1 class="heading-display max-w-[558px] text-white animate-fade-up">
      Build Your Next Great Adventure
    </h1>
    <p class="mt-6 sm:mt-7 font-roboto font-bold uppercase text-gallery text-[16px] leading-[20px] sm:text-[20px] animate-fade-up [animation-delay:120ms]">
      Intuitive &amp; versatile TTRPG terrain
    </p>
  </div>

  <div class="absolute inset-x-0 bottom-[-46px] sm:bottom-[-70px] z-20 flex justify-center px-5">
    <nav class="flex gap-1 bg-alabaster p-1 shadow-[0_4px_8px_rgba(0,0,0,0.15)] animate-fade-up [animation-delay:240ms]"
         aria-label="Shop by category">
      <a href="/kits" class="cta-tile">
        <img src="/images/home-v2/cta-kits.svg" alt="" aria-hidden="true" class="cta-tile-icon" />
        <span class="cta-tile-label">Kits</span>
      </a>
      <a href="/tiles" class="cta-tile">
        <img src="/images/home-v2/cta-tiles.svg" alt="" aria-hidden="true" class="cta-tile-icon" />
        <span class="cta-tile-label">Tiles</span>
      </a>
      <a href="/terrain" class="cta-tile">
        <img src="/images/home-v2/cta-terrain.svg" alt="" aria-hidden="true" class="cta-tile-icon" />
        <span class="cta-tile-label">Terrain</span>
      </a>
      <a href="/products" class="cta-tile cta-tile--active" aria-current="page">
        <img src="/images/home-v2/cta-shop.svg" alt="" aria-hidden="true"
             class="cta-tile-icon !h-[45px] -mt-[4px] -mb-[9px] sm:!h-[69px] sm:-mt-[6px] sm:-mb-[14px]" />
        <span class="cta-tile-label">Shop</span>
      </a>
    </nav>
  </div>
</section>


{# ═══════════════════════════════════════════════════════
   FEATURES — Figma 94:8
═══════════════════════════════════════════════════════ #}
<section id="features" class="relative bg-white pt-[100px] sm:pt-[150px] xl:pt-[177px] pb-16 xl:pb-2" aria-label="Key features">
  <div class="container-home xl:flex xl:items-start xl:justify-between">

    <div class="relative z-0 xl:w-[559px] xl:shrink-0">
      <h2 class="heading-section reveal">Landscapes as Diverse as your Imagination</h2>
      <p class="body-lead mt-6 sm:mt-[29px] max-w-[500px] text-black reveal">
        Epochscapes is an intuitive and versatile TTRPG terrain that allows any dungeon master to quickly
        create their battle map and scene before their players' eyes. Bring your setting into reality.
      </p>

      {% call brushMask(
        src='/images/home-v2/features-pov.jpg',
        alt="A miniature's-eye view down an Epochscapes grass path between stone walls and pine trees",
        frame='/images/home-v2/sight-seeing-45.png',
        frameClass='-scale-x-100',
        photoStyle='left:0;top:0.72%;width:98.76%;height:96.53%;',
        class='reveal mt-[31px] -ml-5 w-[calc(100%+40px)] aspect-[889/691] sm:-ml-8 sm:w-[calc(100%+64px)] xl:-ml-[148px] xl:w-[889px]'
      ) %}
        <a href="/kits" class="btn-cta absolute left-5 top-0 z-10 sm:left-8 xl:left-[148px]">Get Started Today!</a>
      {% endcall %}
    </div>

    <div class="relative z-10 mt-4 flex flex-col gap-12 bg-white px-[26px] py-[52px] shadow-[0_4px_15px_rgba(0,0,0,0.25)]
                xl:mt-[2px] xl:min-h-[785px] xl:w-[459px] xl:shrink-0 xl:justify-between xl:gap-0 reveal"
         style="--reveal-delay: 120ms">
      <div class="feature-item">
        <img src="/images/home-v2/icon-double-sided.svg" alt="" aria-hidden="true" class="h-[61px] w-[61px]" />
        <h3 class="feature-title">Double-Sided Tiles</h3>
        <p class="feature-body">
          Create your battle-map with your choice of sand, water, stone, castle, grass, and more!
          Double-sided tiles get you more creative bang for your buck.
        </p>
      </div>
      <div class="feature-item">
        <img src="/images/home-v2/icon-magnetic.svg" alt="" aria-hidden="true" class="h-[55.43px] w-[60px]" />
        <h3 class="feature-title">Magnetic Connection</h3>
        <p class="feature-body">
          Our magnetic dungeon tiles' lightweight and easily interchangeable design makes setup (and takedown)
          a breeze. No tin trays. No finger-aching clips. Just terrain that seemingly builds itself.
        </p>
      </div>
      <div class="feature-item">
        <img src="/images/home-v2/icon-modular.svg" alt="" aria-hidden="true" class="h-[60px] w-[74.88px]" />
        <h3 class="feature-title">Modular Terrain</h3>
        <p class="feature-body">
          Embark on epic adventures anytime, anywhere. Our terrain is the dynamic solution for any tabletop
          or war game that works with the standard 25mm scale.
        </p>
      </div>
    </div>

  </div>
</section>


{# ═══════════════════════════════════════════════════════
   EXPLORE OUR KITS — Figma 94:10
═══════════════════════════════════════════════════════ #}
<section id="kits" class="relative bg-white" aria-label="Explore our kits">
  {{ inkDivider('mirror') }}

  <div class="relative z-10 -mt-px bg-black">
    <div class="container-home pt-3">
      <div class="flex flex-col gap-6 sm:flex-row sm:items-center sm:justify-between">
        <h2 class="heading-section text-gallery sm:text-[40px] reveal">Explore Our Kits</h2>
        <a href="/kits" class="btn-cta self-start sm:self-auto reveal">Shop All Kits</a>
      </div>

      <div class="mt-10 grid grid-cols-2 gap-3 sm:mt-[60px] sm:gap-[15px] lg:mx-auto lg:max-w-[1051px] lg:grid-cols-4">
        {% for p in kits %}
          <a href="{{ p.slug }}" class="kit-card reveal" style="--reveal-delay: {{ loop.index0 * 90 }}ms"
             aria-label="{{ p.name }} — {{ p.priceLabel }}">
            <img src="{{ p.card.bg }}" alt="" class="kit-card-bg" loading="lazy" decoding="async" />
            <img src="{{ p.card.art }}" alt="" class="kit-card-art" style="{{ p.card.artStyle }}" loading="lazy" decoding="async" />
            <span class="kit-card-name">{{ p.card.nameLines[0] }}<br />{{ p.card.nameLines[1] }}</span>
          </a>
        {% endfor %}
      </div>
    </div>
  </div>

  {{ inkDivider('flip', style='margin-top: calc(clamp(40px, 12.78vw, 184px) * -1);') }}
</section>


{# ═══════════════════════════════════════════════════════
   BENEFITS + PRODUCTS — Figma 94:12
═══════════════════════════════════════════════════════ #}
<section id="how-it-works" class="bg-white pt-14 pb-14 sm:pt-[59px] sm:pb-[59px]" aria-label="How it works">
  <div class="container-home">
    <h2 class="heading-section max-w-[583px] reveal">Insanely Intuitive To Build &amp; Change.</h2>
    <p class="mt-6 max-w-[762px] font-sans text-[16px] leading-[28px] text-black sm:mt-5 sm:text-[18px] sm:leading-[32.4px] reveal">
      You prepared a castle before the game, but the players wanted to go to the forest? Happens all the time.
      Epochscapes makes it easy to completely shift the scene in minutes. Take your dungeon terrain to a new level.
      Let your players fight the monster when it's best for the story. Let them find the hidden gold with dynamic
      scenery. Make unbounded arenas that befit their miniatures. Learn what it feels like to have terrain that
      makes you more flexible, not less.
    </p>

    {{ brushMask(
      src='/images/home-v2/lifestyle-49.jpg',
      alt='A player in a vine crown reaches across an Epochscapes table mid-session',
      frame='/images/home-v2/sight-seeing-44.png',
      frameClass='rotate-180',
      photoStyle='left:0.625%;top:0;width:98.02%;height:99.86%;',
      class='reveal mt-4 -mx-5 w-[calc(100%+40px)] aspect-[960/627] sm:mx-auto sm:mt-[2px] sm:w-full sm:max-w-[960px]'
    ) }}

    <h2 class="heading-section mt-12 text-center sm:mt-[50px] reveal">Modular &amp; Versatile</h2>
    <p class="mx-auto mt-4 max-w-[579px] text-center font-sans font-medium text-[16px] leading-[28px] text-ink-muted sm:mt-[22px] sm:text-[18px] sm:leading-[32.4px] reveal">
      Keep your players highly engaged with Epoch Tile's detailed custom pieces while building a tabletop fantasy
      world from your imagination.
    </p>

    <div class="mt-8 sm:mt-[22px] reveal" x-data="carousel" @resize.window.debounce.150ms="measure()">
      <ul x-ref="track" @scroll.debounce.80ms="measure()"
          class="flex snap-x snap-mandatory gap-[28px] overflow-x-auto [scrollbar-width:none] [&::-webkit-scrollbar]:hidden"
          aria-label="Products">
        {% for p in carousel %}
          <li class="w-[calc((100%-28px)/2)] shrink-0 snap-start lg:w-[calc((100%-84px)/4)]">
            <a href="{{ p.slug }}" class="group relative block aspect-square overflow-hidden bg-placeholder"
               aria-label="{{ p.name }} — {{ p.priceLabel }}">
              {% if p.card %}
                <img src="{{ p.card.bg }}" alt="" class="absolute inset-0 h-full w-full object-cover transition-transform duration-700 ease-out group-hover:scale-105" loading="lazy" decoding="async" />
                <img src="{{ p.card.art }}" alt="" class="absolute left-1/2 top-[8%] h-[64%] w-auto max-w-none -translate-x-1/2 object-contain" loading="lazy" decoding="async" />
              {% endif %}
              <span class="absolute inset-x-0 bottom-0 p-3 sm:p-4 {% if p.card %}bg-gradient-to-t from-black/80 to-transparent text-white{% else %}text-ink{% endif %}">
                <span class="block font-open font-bold uppercase leading-tight text-[12px] sm:text-[14px]">{{ p.name }}</span>
                <span class="mt-1 block font-sans font-medium text-[12px] sm:text-[13px]">{{ p.priceLabel }}</span>
              </span>
            </a>
          </li>
        {% endfor %}
      </ul>

      <div class="mt-8 flex justify-center gap-[13px] sm:mt-[36px]" x-show="pages > 1" x-cloak>
        <template x-for="i in pages" :key="i">
          <button type="button" @click="go(i - 1)" :aria-label="'Show products page ' + i" :aria-current="page === i - 1">
            <img :src="page === i - 1 ? '/images/home-v2/dot-active.svg' : '/images/home-v2/dot.svg'" alt="" class="block h-[18px] w-[18px]" />
          </button>
        </template>
      </div>
    </div>
  </div>
</section>


{# ═══════════════════════════════════════════════════════
   MID CTA — Figma 94:33
═══════════════════════════════════════════════════════ #}
<section id="battle-maps" class="relative bg-white" aria-label="Create battle maps">
  {{ inkDivider('mirror') }}

  <div class="relative -mt-px overflow-hidden bg-black">
    <img src="/images/home-v2/mid-cta-bg.jpg" alt="" aria-hidden="true"
         class="absolute inset-0 h-full w-full max-w-none object-cover object-[50%_77%]" loading="lazy" decoding="async" />
    <div class="absolute inset-0" aria-hidden="true"
         style="background: linear-gradient(180deg, #000 5.9%, rgba(0,0,0,0.9) 16.5%, rgba(0,0,0,0) 100%);"></div>

    <div class="container-home relative z-10 flex flex-col items-center pt-10 pb-[180px] text-center sm:pt-[58px] sm:pb-[252px]">
      <h2 class="heading-section max-w-[479px] text-gallery reveal">Create Battle Maps On The Fly</h2>
      <p class="mt-4 max-w-[645px] font-sans font-medium text-[16px] leading-[28px] text-white sm:mt-[19px] sm:text-[18px] sm:leading-[32.4px] reveal">
        Keep your players highly engaged with Epoch Tile's detailed custom pieces while building a tabletop fantasy
        world from your imagination.
      </p>
      <a href="/kits" class="btn-cta mt-8 reveal">Shop All Kits</a>
    </div>
  </div>
</section>


{# ═══════════════════════════════════════════════════════
   STAY UPDATED — Figma 94:86
═══════════════════════════════════════════════════════ #}
<section id="stay-updated" class="bg-white pt-16 pb-20 sm:pt-[156px] sm:pb-[126px]" aria-label="Stay updated">
  <div class="container-home">
    <div class="flex flex-wrap items-center justify-between gap-6">
      <h2 class="heading-section reveal">Stay Updated</h2>
      <div class="flex gap-3 reveal" aria-label="Social media links">
        <a href="{{ social.instagram }}" class="social-btn" aria-label="Epochscapes on Instagram">
          <img src="/images/home-v2/social-instagram.svg" alt="" class="h-full w-full" />
        </a>
        <a href="{{ social.facebook }}" class="social-btn" aria-label="Epochscapes on Facebook">
          <img src="/images/home-v2/social-facebook-glyph.svg" alt="" class="h-[23px] w-[13px] sm:h-[28.34px] sm:w-[16px]" />
        </a>
        <a href="{{ social.youtube }}" class="social-btn" aria-label="Epochscapes on YouTube">
          <img src="/images/home-v2/social-youtube-glyph.svg" alt="" class="h-[22px] w-[31px] sm:h-[27.35px] sm:w-[38.71px]" />
        </a>
      </div>
    </div>

    <div class="mt-10 bg-alabaster px-4 pt-4 pb-7 sm:mt-[53px] sm:px-[26px] reveal">
      {% if elfsightAppId %}
        <script src="https://static.elfsight.com/platform/platform.js" async></script>
        <div class="elfsight-app-{{ elfsightAppId }}" data-elfsight-app-lazy aria-label="Social media feed"></div>
      {% else %}
        <div class="flex items-center gap-3 sm:gap-[17px] sm:pl-[20px]">
          <img src="/images/home-v2/social-avatar.svg" alt="" aria-hidden="true"
               class="-my-[11px] -ml-[15px] -mr-[15px] h-[97px] w-[97px] max-w-none" />
          <div class="min-w-0">
            <p class="font-sans font-bold uppercase text-ink-deep text-[16px] tracking-[0.8px]">Epochscapes</p>
            <p class="font-sans font-light text-ink-deep text-[14px] tracking-[0.7px]">@epochscapes</p>
          </div>
          <a href="{{ social.instagram }}" class="ml-auto font-kameron font-bold capitalize text-instagram text-[18px] underline sm:mr-[43px]">Follow</a>
        </div>

        <ul class="mt-[27px] grid grid-cols-2 gap-3 sm:grid-cols-3 sm:gap-x-[40px] sm:gap-y-[22px]" aria-label="Latest Instagram posts">
          {% for i in range(0, 6) %}
            <li class="aspect-square bg-white" data-placeholder="instagram-post"></li>
          {% endfor %}
        </ul>

        <div class="mt-[21px] flex justify-center">
          <a href="{{ social.instagram }}" class="btn-cta font-open">Load More</a>
        </div>
      {% endif %}
    </div>
  </div>
</section>


{# ═══════════════════════════════════════════════════════
   JOIN THE ADVENTURE — Figma 94:116
═══════════════════════════════════════════════════════ #}
<section id="join" class="relative overflow-hidden bg-white" aria-label="Join the adventure">
  <div class="absolute inset-x-0 top-[30px] bottom-0" aria-hidden="true">
    <img src="/images/home-v2/close-cta-bg.jpg" alt="" class="absolute inset-0 h-full w-full max-w-none object-cover object-[50%_84%]" loading="lazy" decoding="async" />
    <div class="absolute inset-0" style="background: linear-gradient(180deg, #fff 20%, rgba(255,255,255,0.4) 70%);"></div>
  </div>
  {{ inkDivider('mirror', tall=true, class='absolute inset-x-0 bottom-0') }}

  <div class="container-home relative z-10 pt-[33px] pb-[150px] sm:pb-[220px] lg:flex lg:items-start lg:justify-between">
    <div class="lg:pl-[11px]">
      <h2 class="heading-display max-w-[558px] text-black reveal">Join The Adventure</h2>
      <p class="mt-5 max-w-[411px] font-sans font-medium text-[16px] leading-[23.8px] text-ink-muted sm:mt-[27px] sm:text-[18px] reveal">
        Stay in touch to be the first to know about future product launches and other great things from Epoch!
      </p>
    </div>

    <form class="mt-8 flex w-full flex-col gap-5 sm:gap-[33px] lg:mt-0 lg:mr-[45px] lg:w-[485px] reveal"
          style="--reveal-delay: 120ms"
          onsubmit="event.preventDefault(); alert('Email signup coming soon!')">
      <div class="field-inline">
        <label for="join-name">Name:</label>
        <input id="join-name" type="text" name="name" autocomplete="name" />
      </div>
      <div class="field-inline">
        <label for="join-email">Email:</label>
        <input id="join-email" type="email" name="email" autocomplete="email" required />
      </div>
      <button type="submit"
              class="h-[57px] w-full font-open font-bold text-[20px] uppercase text-white transition-[filter] hover:brightness-110"
              style="background-image: linear-gradient(-83.3deg, #be2e17 0%, #ee4d20 100%);">
        Subscribe
      </button>
    </form>
  </div>
</section>

{% endblock %}

{% block scripts %}
<script>
  document.addEventListener('alpine:init', function () {
    Alpine.data('carousel', function () {
      return {
        page: 0,
        pages: 1,
        perPage: 1,
        init: function () { this.$nextTick(() => this.measure()); },
        step: function () {
          var first = this.$refs.track.children[0];
          var gap = parseFloat(getComputedStyle(this.$refs.track).columnGap) || 0;
          return first ? first.offsetWidth + gap : 0;
        },
        measure: function () {
          var track = this.$refs.track;
          var step = this.step();
          if (!step) return;
          var gap = parseFloat(getComputedStyle(track).columnGap) || 0;
          this.perPage = Math.max(1, Math.round((track.clientWidth + gap) / step));
          this.pages = Math.ceil(track.children.length / this.perPage);
          this.page = Math.min(this.pages - 1, Math.round(track.scrollLeft / (step * this.perPage)));
        },
        go: function (i) {
          this.$refs.track.scrollTo({ left: i * this.step() * this.perPage, behavior: 'smooth' });
        },
      };
    });
  });
</script>
{% endblock %}

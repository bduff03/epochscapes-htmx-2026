<!DOCTYPE html>
<html lang="en" class="scroll-smooth">
<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0" />
  <meta name="description" content="Epochscapes — Magnetic dungeon tiles & modular TTRPG terrain. Build your next great adventure." />
  <title>{{ title or "Epochscapes — Magnetic Dungeon Tiles" }}</title>

  <!-- Google Fonts: Oswald (display/headings) + Inter (body) -->
  <link rel="preconnect" href="https://fonts.googleapis.com" />
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
  <link href="https://fonts.googleapis.com/css2?family=Oswald:wght@400;500;600;700&family=Inter:wght@300;400;500;600&display=swap" rel="stylesheet" />

  <!-- Tailwind (compiled) -->
  <link rel="stylesheet" href="/css/style.css" />

  <!-- HTMX -->
  <script src="https://unpkg.com/htmx.org@1.9.11" defer></script>

  <!-- Alpine.js (mobile nav, FAQ accordion) -->
  <script defer src="https://cdn.jsdelivr.net/npm/alpinejs@3.x.x/dist/cdn.min.js"></script>

  {% block head %}{% endblock %}
</head>
<body class="bg-white">

  {% include "partials/header.njk" %}

  <main id="main-content">
    {% block content %}{% endblock %}
  </main>

  {% include "partials/footer.njk" %}

  {% block scripts %}{% endblock %}
</body>
</html>

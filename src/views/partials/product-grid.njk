{% if products.length %}
  <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-4 gap-4">
    {% for p in products %}
      <article class="group border border-zinc-100 overflow-hidden
                      transition-all duration-300 bg-white
                      hover:border-brand-green/40 hover:shadow-[0_4px_24px_rgba(74,124,89,0.12)]
                      hover:-translate-y-0.5"
               aria-label="{{ p.name }}">

        {# Gradient thumbnail — TODO: replace with real product photography #}
        <div class="relative h-44 {{ p.thumb }} overflow-hidden">
          {% if p.badge %}
            <span class="absolute top-3 left-3 px-2 py-0.5
                         bg-brand-red text-white text-[10px]
                         font-display font-semibold tracking-widest uppercase">
              {{ p.badge }}
            </span>
          {% endif %}
          <span class="absolute bottom-2 left-3 px-2 py-0.5
                       bg-black/40 text-white/70 text-[9px] font-display tracking-widest uppercase">
            {{ p.category }}
          </span>
        </div>

        <div class="p-4">
          <h3 class="text-sm font-display font-semibold text-brand-off-black tracking-wide uppercase
                     leading-snug mb-1 group-hover:text-brand-green transition-colors">
            {{ p.name }}
          </h3>

          {% if p.description %}
            <p class="text-[11px] text-zinc-500 leading-relaxed mb-3 line-clamp-2">
              {{ p.description }}
            </p>
          {% endif %}

          <div class="flex items-center justify-between pt-3 border-t border-zinc-100">
            <span class="text-brand-green font-display font-semibold text-sm tracking-wide">
              {{ p.priceLabel }}
            </span>
            {# TODO: Replace href with Hostinger checkout URL #}
            <a href="{{ p.slug or '#' }}"
               class="text-[10px] font-display font-semibold tracking-widest uppercase
                      text-zinc-400 border border-zinc-200 px-3 py-1.5
                      hover:border-brand-red hover:text-brand-red transition-colors"
               aria-label="View {{ p.name }}">
              View →
            </a>
          </div>
        </div>
      </article>
    {% endfor %}
  </div>
{% else %}
  <p class="text-zinc-400 text-center py-10 font-sans text-sm">No products found.</p>
{% endif %}

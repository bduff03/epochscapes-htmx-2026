{% if products.length %}
  <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-4 gap-4">
    {% set tileImages = [
      '/images/terrain-651830478.jpeg',
      '/images/terrain-651830444.jpeg',
      '/images/lifestyle-751658706.jpeg',
      '/images/terrain-651830478.jpeg',
      '/images/terrain-651830444.jpeg',
      '/images/lifestyle-751658706.jpeg',
      '/images/terrain-651830478.jpeg',
      '/images/terrain-651830444.jpeg'
    ] %}
    {% set kitImages = [
      '/images/terrain-651830478.jpeg',
      '/images/lifestyle-532216565.jpeg',
      '/images/terrain-651830444.jpeg',
      '/images/lifestyle-751658706.jpeg'
    ] %}
    {% for p in products %}
      <a href="{{ p.slug }}"
         class="group block border border-zinc-100 overflow-hidden rounded-[4px]
                transition-all duration-300 bg-white no-underline
                hover:border-brand-green/40 hover:shadow-[0_4px_24px_rgba(74,124,89,0.12)]
                hover:-translate-y-0.5 focus-visible:ring-2 focus-visible:ring-brand-green
                focus-visible:ring-offset-2 focus-visible:outline-none"
         aria-label="{{ p.name }}{% if p.priceLabel %} — {{ p.priceLabel }}{% endif %}">

        <div class="relative h-44 overflow-hidden">
          {% if p.category === 'kits' %}
            <img
              src="{{ kitImages[loop.index0 % 4] }}"
              alt="{{ p.name }}"
              class="w-full h-full object-cover transition-transform duration-500 group-hover:scale-105"
              loading="lazy"
            />
            <div class="absolute inset-0 bg-gradient-to-t from-black/30 to-transparent"></div>
          {% elif p.category === 'tiles' %}
            <img
              src="{{ tileImages[loop.index0 % 8] }}"
              alt="{{ p.name }}"
              class="w-full h-full object-cover transition-transform duration-500 group-hover:scale-105"
              loading="lazy"
            />
            <div class="absolute inset-0 bg-gradient-to-t from-black/25 to-transparent"></div>
          {% else %}
            <div class="absolute inset-0 {{ p.thumb }}"></div>
          {% endif %}

          {% if p.badge %}
            <span class="absolute top-3 left-3 px-2 py-0.5
                         bg-brand-red text-white text-[10px]
                         font-sans font-bold tracking-widest uppercase z-10">
              {{ p.badge }}
            </span>
          {% endif %}
          <span class="absolute bottom-2 left-3 px-2 py-0.5 z-10
                       bg-black/40 text-white/70 text-[9px] font-sans tracking-widest uppercase">
            {{ p.category }}
          </span>
        </div>

        <div class="p-4">
          <h3 class="text-[13px] font-sans font-bold text-[#333333] tracking-[0.05em] uppercase
                     leading-snug mb-1 group-hover:text-brand-green transition-colors">
            {{ p.name }}
          </h3>

          {% if p.description %}
            <p class="text-[#666666] text-[12px] leading-relaxed mb-3 line-clamp-2">
              {{ p.description }}
            </p>
          {% endif %}

          <div class="flex items-center justify-between pt-3 border-t border-zinc-100">
            <span class="text-brand-green font-sans font-bold text-[13px] tracking-wide">
              {{ p.priceLabel }}
            </span>
            <span class="text-[10px] font-sans font-bold tracking-widest uppercase
                         text-zinc-400 border border-zinc-200 px-3 py-1.5
                         group-hover:border-brand-red group-hover:text-brand-red transition-colors"
                  aria-hidden="true">
              View →
            </span>
          </div>
        </div>
      </a>
    {% endfor %}
  </div>
{% else %}
  <p class="text-[#666666] text-center py-10 font-sans text-[14px]">No products found.</p>
{% endif %}

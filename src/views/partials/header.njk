<header
  class="fixed inset-x-0 top-0 z-50 border-b border-transparent
         transition-[border-color,background-color] duration-300"
  x-data="{ open: false, scrolled: false }"
  x-init="window.addEventListener('scroll', () => { scrolled = window.scrollY > 20 })"
  :class="scrolled ? 'border-brand-border bg-brand-bg/95 backdrop-blur-md' : ''"
  role="banner"
>
  <div class="mx-auto max-w-7xl px-4 sm:px-6 lg:px-8">
    <div class="flex h-16 items-center justify-between">

      <!-- Logo -->
      <a href="/" class="flex items-center gap-2.5 group" aria-label="Epochscapes — Home">
        <!-- Tile mark SVG -->
        <svg class="w-8 h-8 text-brand-gold shrink-0" viewBox="0 0 32 32" fill="none" aria-hidden="true">
          <rect x="1" y="1" width="13" height="13" rx="2" stroke="currentColor" stroke-width="1.5"/>
          <rect x="18" y="1" width="13" height="13" rx="2" fill="currentColor" fill-opacity="0.25" stroke="currentColor" stroke-width="1.5"/>
          <rect x="1" y="18" width="13" height="13" rx="2" fill="currentColor" fill-opacity="0.25" stroke="currentColor" stroke-width="1.5"/>
          <rect x="18" y="18" width="13" height="13" rx="2" stroke="currentColor" stroke-width="1.5"/>
          <!-- magnetic center dot -->
          <circle cx="16" cy="16" r="1.5" fill="currentColor"/>
        </svg>
        <span class="font-display font-semibold text-white text-base tracking-widest uppercase
                     group-hover:text-brand-gold transition-colors">
          Epochscapes
        </span>
      </a>

      <!-- Desktop nav -->
      <nav class="hidden md:flex items-center gap-8" aria-label="Primary navigation">
        <a href="/#categories" class="nav-link pb-0.5">Kits</a>
        <a href="/#categories" class="nav-link pb-0.5">Tiles</a>
        <a href="/#features"   class="nav-link pb-0.5">How It Works</a>
        <a href="/about"       class="nav-link pb-0.5">About</a>
      </nav>

      <!-- Desktop actions -->
      <div class="hidden md:flex items-center gap-3">
        {# Cart placeholder — TODO: wire to Hostinger cart API #}
        <a href="/cart" aria-label="Shopping cart (0 items)"
           class="relative p-2 text-brand-muted hover:text-white transition-colors">
          <svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24" stroke-width="1.8" aria-hidden="true">
            <path stroke-linecap="round" stroke-linejoin="round"
                  d="M2.25 3h1.386c.51 0 .955.343 1.087.835l.383 1.437M7.5 14.25a3 3 0 00-3 3h15.75m-12.75-3h11.218c1.121-2.3 2.1-4.684 2.962-7.138a60.114 60.114 0 00-16.536-1.84M7.5 14.25L5.106 5.272M6 20.25a.75.75 0 11-1.5 0 .75.75 0 011.5 0zm12.75 0a.75.75 0 11-1.5 0 .75.75 0 011.5 0z"/>
          </svg>
        </a>
        <a href="/#categories" class="btn-primary text-xs px-5 py-2.5">Shop Now</a>
      </div>

      <!-- Mobile menu button -->
      <button
        @click="open = !open"
        class="md:hidden p-2 text-brand-muted hover:text-white transition-colors"
        :aria-expanded="open"
        aria-label="Toggle navigation menu"
        aria-controls="mobile-menu"
      >
        <svg x-show="!open" class="w-6 h-6" fill="none" stroke="currentColor" viewBox="0 0 24 24" stroke-width="1.8" aria-hidden="true">
          <path stroke-linecap="round" stroke-linejoin="round" d="M3.75 6.75h16.5M3.75 12h16.5m-16.5 5.25h16.5"/>
        </svg>
        <svg x-show="open" class="w-6 h-6" fill="none" stroke="currentColor" viewBox="0 0 24 24" stroke-width="1.8" aria-hidden="true">
          <path stroke-linecap="round" stroke-linejoin="round" d="M6 18L18 6M6 6l12 12"/>
        </svg>
      </button>
    </div>
  </div>

  <!-- Mobile menu -->
  <div
    id="mobile-menu"
    x-show="open"
    x-transition:enter="transition ease-out duration-200"
    x-transition:enter-start="opacity-0 -translate-y-2"
    x-transition:enter-end="opacity-100 translate-y-0"
    x-transition:leave="transition ease-in duration-150"
    x-transition:leave-start="opacity-100"
    x-transition:leave-end="opacity-0"
    class="md:hidden border-t border-brand-border bg-brand-bg/98 backdrop-blur-md"
  >
    <nav class="px-4 py-5 space-y-1" aria-label="Mobile navigation">
      <a @click="open=false" href="/#categories" class="block px-3 py-2.5 text-sm font-sans text-brand-muted hover:text-white hover:bg-brand-surface rounded transition-colors">Kits</a>
      <a @click="open=false" href="/#categories" class="block px-3 py-2.5 text-sm font-sans text-brand-muted hover:text-white hover:bg-brand-surface rounded transition-colors">Tiles</a>
      <a @click="open=false" href="/#features"   class="block px-3 py-2.5 text-sm font-sans text-brand-muted hover:text-white hover:bg-brand-surface rounded transition-colors">How It Works</a>
      <a @click="open=false" href="/about"        class="block px-3 py-2.5 text-sm font-sans text-brand-muted hover:text-white hover:bg-brand-surface rounded transition-colors">About</a>
      <div class="pt-3 pb-1">
        <a href="/#categories" class="btn-primary w-full justify-center">Shop Now</a>
      </div>
    </nav>
  </div>
</header>

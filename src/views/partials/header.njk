<header
  class="fixed inset-x-0 top-0 z-50"
  x-data="{ open: false }"
  role="banner"
  style="background: rgba(0,0,0,0.85); backdrop-filter: blur(8px); -webkit-backdrop-filter: blur(8px);"
>
  <div class="mx-auto max-w-7xl px-5 sm:px-8">
    <div class="flex h-[76px] items-center justify-between gap-8">

      <!-- Logo wordmark -->
      <a href="/" class="flex items-center shrink-0 group" aria-label="Epochscapes — Home">
        <img
          src="/images/es-logo-long.png"
          alt="Epochscapes"
          class="h-7 sm:h-8 w-auto object-contain"
          style="filter: brightness(1);"
        />
      </a>

      <!-- Desktop nav -->
      <nav class="hidden md:flex items-center gap-8 flex-1 justify-center" aria-label="Primary navigation">
        <div class="relative group" x-data="{ open: false }">
          <button
            @click="open = !open"
            @keydown.escape="open = false"
            class="nav-item"
            :aria-expanded="open"
            aria-haspopup="true"
          >
            Shop
            <svg class="w-3 h-3 transition-transform duration-200" :class="open ? 'rotate-180' : ''" fill="currentColor" viewBox="0 0 10 6" aria-hidden="true">
              <path d="M0 0l5 6 5-6z"/>
            </svg>
          </button>
          <div
            x-show="open"
            @click.outside="open = false"
            x-transition:enter="transition ease-out duration-150"
            x-transition:enter-start="opacity-0 translate-y-1"
            x-transition:enter-end="opacity-100 translate-y-0"
            x-transition:leave="transition ease-in duration-100"
            x-transition:leave-start="opacity-100"
            x-transition:leave-end="opacity-0"
            class="absolute top-full left-1/2 -translate-x-1/2 mt-2 w-44 bg-white shadow-xl border border-zinc-100 py-1"
          >
            <a href="/kits"  class="block px-4 py-2.5 text-xs font-display tracking-widest uppercase text-zinc-700 hover:bg-zinc-50 hover:text-brand-green transition-colors">Kits</a>
            <a href="/tiles" class="block px-4 py-2.5 text-xs font-display tracking-widest uppercase text-zinc-700 hover:bg-zinc-50 hover:text-brand-green transition-colors">Tiles</a>
            <a href="/terrain" class="block px-4 py-2.5 text-xs font-display tracking-widest uppercase text-zinc-700 hover:bg-zinc-50 hover:text-brand-green transition-colors">Terrain</a>
            <div class="border-t border-zinc-100 my-1"></div>
            <a href="/products" class="block px-4 py-2.5 text-xs font-display tracking-widest uppercase text-zinc-700 hover:bg-zinc-50 hover:text-brand-green transition-colors">All Products</a>
          </div>
        </div>

        <div class="relative" x-data="{ open: false }">
          <button
            @click="open = !open"
            @keydown.escape="open = false"
            class="nav-item"
            :aria-expanded="open"
          >
            About
            <svg class="w-3 h-3 transition-transform duration-200" :class="open ? 'rotate-180' : ''" fill="currentColor" viewBox="0 0 10 6" aria-hidden="true">
              <path d="M0 0l5 6 5-6z"/>
            </svg>
          </button>
          <div
            x-show="open"
            @click.outside="open = false"
            x-transition:enter="transition ease-out duration-150"
            x-transition:enter-start="opacity-0 translate-y-1"
            x-transition:enter-end="opacity-100 translate-y-0"
            x-transition:leave="transition ease-in duration-100"
            x-transition:leave-start="opacity-100"
            x-transition:leave-end="opacity-0"
            class="absolute top-full left-1/2 -translate-x-1/2 mt-2 w-44 bg-white shadow-xl border border-zinc-100 py-1"
          >
            <a href="/about"    class="block px-4 py-2.5 text-xs font-display tracking-widest uppercase text-zinc-700 hover:bg-zinc-50 hover:text-brand-green transition-colors">Our Story</a>
            <a href="/about#how-it-works" class="block px-4 py-2.5 text-xs font-display tracking-widest uppercase text-zinc-700 hover:bg-zinc-50 hover:text-brand-green transition-colors">How It Works</a>
          </div>
        </div>
      </nav>

      <!-- Cart + mobile toggle -->
      <div class="flex items-center gap-3">
        <a href="/cart"
           aria-label="Shopping cart (0 items)"
           class="text-white/70 hover:text-white transition-colors p-1">
          <svg class="w-6 h-6" fill="none" stroke="currentColor" stroke-width="1.8" viewBox="0 0 24 24" aria-hidden="true">
            <path stroke-linecap="round" stroke-linejoin="round"
                  d="M2.25 3h1.386c.51 0 .955.343 1.087.835l.383 1.437M7.5 14.25a3 3 0 00-3 3h15.75m-12.75-3h11.218c1.121-2.3 2.1-4.684 2.962-7.138a60.114 60.114 0 00-16.536-1.84M7.5 14.25L5.106 5.272M6 20.25a.75.75 0 11-1.5 0 .75.75 0 011.5 0zm12.75 0a.75.75 0 11-1.5 0 .75.75 0 011.5 0z"/>
          </svg>
        </a>

        <button
          @click="open = !open"
          :aria-expanded="open"
          aria-controls="mobile-menu"
          aria-label="Toggle navigation"
          class="md:hidden text-white/70 hover:text-white transition-colors p-1"
        >
          <svg x-show="!open" class="w-6 h-6" fill="none" stroke="currentColor" stroke-width="1.8" viewBox="0 0 24 24" aria-hidden="true">
            <path stroke-linecap="round" stroke-linejoin="round" d="M3.75 6.75h16.5M3.75 12h16.5m-16.5 5.25h16.5"/>
          </svg>
          <svg x-show="open" class="w-6 h-6" fill="none" stroke="currentColor" stroke-width="1.8" viewBox="0 0 24 24" aria-hidden="true">
            <path stroke-linecap="round" stroke-linejoin="round" d="M6 18L18 6M6 6l12 12"/>
          </svg>
        </button>
      </div>
    </div>
  </div>

  <!-- Mobile menu -->
  <div
    id="mobile-menu"
    x-show="open"
    x-transition:enter="transition ease-out duration-200"
    x-transition:enter-start="opacity-0 -translate-y-2"
    x-transition:enter-end="opacity-100 translate-y-0"
    x-transition:leave="transition ease-in duration-150"
    x-transition:leave-start="opacity-100"
    x-transition:leave-end="opacity-0"
    class="md:hidden bg-black/95 border-t border-white/10"
  >
    <nav class="px-5 py-6 space-y-1" aria-label="Mobile navigation">
      <p class="text-white/30 text-[10px] font-display tracking-widest uppercase mb-3">Shop</p>
      <a @click="open=false" href="/kits"  class="block px-2 py-2.5 text-sm font-display tracking-widest uppercase text-white/70 hover:text-white">Kits</a>
      <a @click="open=false" href="/tiles" class="block px-2 py-2.5 text-sm font-display tracking-widest uppercase text-white/70 hover:text-white">Tiles</a>
      <a @click="open=false" href="/terrain" class="block px-2 py-2.5 text-sm font-display tracking-widest uppercase text-white/70 hover:text-white">Terrain</a>
      <div class="border-t border-white/10 my-3"></div>
      <a @click="open=false" href="/about"  class="block px-2 py-2.5 text-sm font-display tracking-widest uppercase text-white/70 hover:text-white">About</a>
      <div class="pt-4">
        <a href="/products" class="btn-cta w-full justify-center text-xs py-3">Shop Now</a>
      </div>
    </nav>
  </div>
</header>

# Environment variables — copy to .env and fill in values
# No secrets are required for local development (the homepage uses only mock data)

# Port the dev server listens on (default: 3000)
PORT=3000

# Set to "production" to disable Nunjucks live-reload and caching
NODE_ENV=development

# ─── Elfsight Social Feed (Stay Updated section) ────────────────────────────
# Set this to the Elfsight app ID Brad supplies (format: xxxxxxxx-xxxx-xxxx-xxxx-xxxxxxxxxxxx).
# When set, the live social feed widget renders in the Stay Updated section.
# When unset, a clearly-labelled placeholder renders instead.
#
# To activate:
#   1. Obtain the Elfsight app id from the Elfsight dashboard (Apps > your app > embed code)
#   2. Add the line below to your .env file (no quotes needed)
#   3. Restart the dev server — the widget appears automatically
#
# ELFSIGHT_APP_ID=xxxxxxxx-xxxx-xxxx-xxxx-xxxxxxxxxxxx

# ─── TODO: Hostinger Ecommerce (future PRs) ───────────────────────────────────
# HOSTINGER_STORE_ID=
# HOSTINGER_API_KEY=
# HOSTINGER_WEBHOOK_SECRET=
